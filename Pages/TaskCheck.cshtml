@page "/TaskCheck"
@model HabitTracker.Pages.TaskCheckModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "タスクのチェック";
}

@*
    モジュール名: Pages/TaskCheck.cshtml
    説明: タスク（習慣）のワンタップ実行記録画面 Razor Page です。
          pico-classless.css と htmx を使用し、JavaScript や過剰な CSS なしで習慣を実行記録します。
*@

<style>
    body { padding-bottom: 70px; }
    .bottom-nav {
        position: fixed; bottom: 0; left: 0; right: 0;
        display: flex; justify-content: space-around;
        background-color: var(--pico-card-background-color, #18232c);
        border-top: 1px solid var(--pico-muted-border-color, #2d3843);
        padding: 8px 0; z-index: 1000; margin: 0; text-align: center;
    }
    .bottom-nav a { text-decoration: none; font-size: 0.85rem; font-weight: bold; flex: 1; color: var(--pico-secondary); }
    .bottom-nav a.active { color: var(--pico-primary); }
</style>

<!-- ヘッダーバー -->
<header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h2 style="margin: 0; font-size: 1.4rem;">習慣トラッカー</h2>
    <div style="display: flex; align-items: center; gap: 12px;">
        <small style="font-weight: bold;">👤 @Model.CurrentUser</small>
        <a href="/Settings" role="button" class="secondary" style="margin-bottom: 0; padding: 4px 10px; font-size: 0.85rem;">⚙️ 設定</a>
    </div>
</header>

<!-- タスクのチェックセクション -->
<section id="section-task-check">
    <h3>✅ マイ習慣一覧（ワンタップ実行）</h3>
    <div id="habits-check-list" hx-get="/htmx/habits/check-list" hx-trigger="load" hx-swap="innerHTML">
        <p>読み込み中...</p>
    </div>
</section>

<!-- ボトムナビゲーションバー -->
<nav class="bottom-nav">
    <a href="/">👥 タイムライン</a>
    <a href="/TaskCheck" class="active">✅ タスクチェック</a>
    <a href="/Settings">⚙️ 設定</a>
</nav>
