@page "/Settings"
@model HabitTracker.Pages.SettingsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "設定";
}

@*
    モジュール名: Pages/Settings.cshtml
    説明: 設定画面の Razor Page です。
          pico-classless.css と htmx を使用し、JavaScript なしで習慣管理・グループ管理・プロフィール・アカウント情報を設定します。
*@

<!-- ヘッダーバー（タイムラインに戻るリンク） -->
<header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <div>
        <a href="/" role="button" class="secondary" style="margin-bottom: 0;">⬅️ タイムラインに戻る</a>
    </div>
    <div>
        <h2 style="margin: 0; font-size: 1.4rem;">⚙️ 設定</h2>
    </div>
    <div>
        <small style="font-weight: bold;">👤 @Model.CurrentUser</small>
    </div>
</header>

<!-- 設定メインコンテンツ -->
<section id="section-settings">

    <!-- 習慣登録フォーム -->
    <article>
        <h3>📝 新しい習慣を登録</h3>
        <form hx-post="/htmx/habits" hx-target="#manage-habits-list" hx-swap="innerHTML" hx-on::after-request="this.reset()">
            <label for="title">習慣のタイトル
                <input type="text" name="title" id="title" required placeholder="例: 毎朝散歩する">
            </label>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <label for="emoji" style="flex: 1;">タスク絵文字
                    <input type="text" name="emoji" id="emoji" value="📝" placeholder="例: 🏃, 📚, 🧘">
                </label>
                <label for="frequency" style="flex: 1;">頻度
                    <select name="frequency" id="frequency">
                        <option value="Daily">毎日</option>
                        <option value="Weekly">毎週</option>
                    </select>
                </label>
            </div>
            <label for="description">詳細メモ（任意）
                <input type="text" name="description" id="description" placeholder="例: 20分以上">
            </label>
            <button type="submit">習慣を追加</button>
        </form>
    </article>

    <!-- 登録済み習慣の管理 -->
    <article>
        <h3>🛠️ 習慣（タスク）の管理</h3>
        <div id="manage-habits-list" hx-get="/htmx/habits/manage-list" hx-trigger="load" hx-swap="innerHTML">
            <p style="opacity: 0.8;">読み込み中...</p>
        </div>
    </article>

    <!-- グループ管理 -->
    <article>
        <h3>👥 所属グループ管理</h3>
        <div id="groups-list" hx-get="/htmx/groups/list" hx-trigger="load" hx-swap="innerHTML" style="margin-bottom: 15px;">
            <p style="opacity: 0.8;">読み込み中...</p>
        </div>
        <hr>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <form hx-post="/htmx/groups" hx-target="#groups-list" hx-swap="innerHTML" hx-on::after-request="this.reset()" style="flex: 1; min-width: 250px;">
                <label for="group-name">新規グループ作成
                    <input type="text" name="name" id="group-name" required placeholder="例: 家族チーム, 開発部">
                </label>
                <button type="submit">グループを作成</button>
            </form>
            <form hx-post="/htmx/groups/join" hx-target="#groups-list" hx-swap="innerHTML" hx-on::after-request="this.reset()" style="flex: 1; min-width: 250px;">
                <label for="invite-code">招待コードで参加
                    <input type="text" name="inviteCode" id="invite-code" required placeholder="例: A1B2C3D4">
                </label>
                <button type="submit" class="secondary">グループに参加</button>
            </form>
        </div>
    </article>

    <!-- ユーザープロフィール設定 -->
    <article>
        <h3>👤 ユーザープロフィール設定</h3>
        <div id="user-profile-section">
            <form hx-post="/htmx/users/profile" hx-target="#user-profile-section" hx-swap="innerHTML" style="display: flex; align-items: center; gap: 10px; margin-bottom: 0;">
                <span style="font-size: 1.1em; font-weight: bold;">@Model.UserEmoji @Model.CurrentUser</span>
                <input type="text" name="emoji" value="@Model.UserEmoji" style="width: 60px; text-align: center; font-size: 1.2em; margin-bottom: 0;">
                <button type="submit" style="width: auto; margin-bottom: 0;">絵文字更新</button>
            </form>
        </div>
    </article>

    <!-- ユーザー名・パスワード変更 -->
    <article>
        <h3>🔒 ユーザー名・パスワード変更</h3>
        @if (!string.IsNullOrEmpty(Model.AccountMessage))
        {
            <mark style="display: block; margin-bottom: 1rem; padding: 8px; border-radius: 4px;">@Model.AccountMessage</mark>
        }
        @if (!string.IsNullOrEmpty(Model.AccountErrorMessage))
        {
            <p style="color: #ef4444; margin-bottom: 1rem;"><small>@Model.AccountErrorMessage</small></p>
        }
        <form method="post" asp-page-handler="ChangeAccount">
            <label for="new-username">新しいユーザー名（変更する場合のみ入力）
                <input type="text" name="newUsername" id="new-username" placeholder="変更後のユーザー名">
            </label>
            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                <label for="current-password" style="flex: 1;">現在のパスワード
                    <input type="password" name="currentPassword" id="current-password" required placeholder="現在のパスワード">
                </label>
                <label for="new-password" style="flex: 1;">新しいパスワード
                    <input type="password" name="newPassword" id="new-password" required placeholder="新しいパスワード">
                </label>
            </div>
            <button type="submit">アカウント情報を変更</button>
        </form>
    </article>

    <!-- ログアウト -->
    <article style="text-align: center;">
        <a href="/logout" role="button" class="contrast outline" style="width: 100%;">🚪 ログアウト</a>
    </article>
</section>
