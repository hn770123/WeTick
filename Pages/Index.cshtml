@page "/"
@model HabitTracker.Pages.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "ダッシュボード";
}

@*
    モジュール名: Pages/Index.cshtml
    説明: HabitTracker のメインダッシュボード画面 Razor Page です。
          pico-classless.css と htmx を使用し、JavaScript や過剰な CSS なしでタイムラインを表示します。
*@

<style>
    body { padding-bottom: 70px; }
    .bottom-nav {
        position: fixed; bottom: 0; left: 0; right: 0;
        display: flex; justify-content: space-around;
        background-color: var(--pico-card-background-color, #18232c);
        border-top: 1px solid var(--pico-muted-border-color, #2d3843);
        padding: 8px 0; z-index: 1000; margin: 0; text-align: center;
    }
    .bottom-nav a { text-decoration: none; font-size: 0.85rem; font-weight: bold; flex: 1; color: var(--pico-secondary); }
    .bottom-nav a.active { color: var(--pico-primary); }
</style>

<!-- ヘッダーバー -->
<header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h2 style="margin: 0; font-size: 1.4rem;">習慣トラッカー</h2>
    <div style="display: flex; align-items: center; gap: 12px;">
        <small style="font-weight: bold;">👤 @Model.CurrentUser</small>
        <a href="/Settings" role="button" class="secondary" style="margin-bottom: 0; padding: 4px 10px; font-size: 0.85rem;">⚙️ 設定</a>
    </div>
</header>

<!-- タイムラインセクション -->
<section id="section-timeline">
    <article>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
            <h3 style="margin: 0;">👥 タイムライン</h3>
            <div style="display: flex; align-items: center; gap: 8px;">
                <label for="group-filter" style="font-weight: bold; margin-bottom: 0;">フィルタ:</label>
                <select name="groupId" id="group-filter" hx-get="/htmx/timeline" hx-target="#timeline-list" hx-swap="innerHTML" style="margin-bottom: 0; padding: 4px 8px;">
                    <option value="">すべての投稿</option>
                    @foreach (var g in Model.UserGroups)
                    {
                        <option value="@g.Id">🏢 @g.Name</option>
                    }
                </select>
            </div>
        </div>
        <div id="timeline-list" hx-get="/htmx/timeline" hx-trigger="load" hx-swap="innerHTML">
            <p>読み込み中...</p>
        </div>
    </article>
</section>

<!-- ボトムナビゲーションバー -->
<nav class="bottom-nav">
    <a href="/" class="active">👥 タイムライン</a>
    <a href="/TaskCheck">✅ タスクチェック</a>
    <a href="/Settings">⚙️ 設定</a>
</nav>
