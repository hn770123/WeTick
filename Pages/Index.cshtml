@page "/"
@model HabitTracker.Pages.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "ダッシュボード";
}

@*
    モジュール名: Pages/Index.cshtml
    説明: HabitTracker のメインダッシュボード画面 Razor Page（htmx統合・ボトムナビゲーション・Pico.css対応）です。
*@

<style>
    /* ボトムナビゲーション固定表示のための画面余白 */
    body {
        padding-bottom: 80px;
    }

    /* 画面下部固定ボトムナビゲーションバーのスタイル設定 */
    .bottom-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-around;
        align-items: center;
        background-color: var(--pico-card-background-color, #18232c);
        border-top: 1px solid var(--pico-muted-border-color, #2d3843);
        padding: 8px 0;
        z-index: 1000;
        margin: 0;
    }

    .bottom-nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        color: var(--pico-secondary, #94a3b8);
        font-size: 0.8rem;
        font-weight: bold;
        flex: 1;
        text-align: center;
        padding: 4px 0;
    }

    .bottom-nav-item .nav-icon {
        font-size: 1.4rem;
        line-height: 1.2;
    }

    .bottom-nav-item.active {
        color: var(--pico-primary, #3b82f6);
    }

    .bottom-nav-item:hover {
        color: var(--pico-primary-hover, #60a5fa);
    }

    /* タブコンテンツ切替制御クラス */
    .view-section {
        display: none;
    }

    .view-section.active {
        display: block;
    }

    /* タイムライン・リスト補助スタイル */
    .habit-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid var(--pico-muted-border-color, #2d3843);
    }

    .habit-item:last-child {
        border-bottom: none;
    }

    .timeline-item {
        margin-bottom: 1rem;
        padding: 1rem;
        border-left: 4px solid var(--pico-primary, #3b82f6);
    }

    .reaction-bar {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 8px;
    }

    .reaction-badge {
        background: var(--pico-muted-border-color, #2d3843);
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 0.9em;
        cursor: pointer;
    }

    .comment-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 6px 10px;
        margin-bottom: 6px;
        background: var(--pico-muted-border-color, #1e293b);
        border-radius: 6px;
    }
</style>

<!-- ヘッダーバー -->
<header style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h2 style="margin: 0; font-size: 1.4rem;" id="page-title">習慣トラッカー - タイムライン</h2>
    <div style="display: flex; align-items: center; gap: 12px;">
        <small style="font-weight: bold;">ログイン中: @Model.CurrentUser</small>
        <a href="/Settings" role="button" class="secondary" style="margin-bottom: 0; padding: 4px 10px; font-size: 0.85rem;">⚙️ 設定</a>
    </div>
</header>

<!-- 1. タイムラインセクション（デフォルト表示） -->
<section id="section-timeline" class="view-section active">
    <article>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
            <h3 style="margin: 0;">👥 タイムライン</h3>
            <div style="display: flex; align-items: center; gap: 8px;">
                <label for="group-filter" style="font-weight: bold; margin-bottom: 0;">表示フィルタ:</label>
                <select id="group-filter" onchange="loadTimeline()" style="margin-bottom: 0; padding: 4px 8px;">
                    <option value="all">すべての投稿</option>
                </select>
            </div>
        </div>
        <div id="timeline-list">読み込み中...</div>
    </article>
</section>

<!-- 2. タスクのチェックセクション -->
<section id="section-task-check" class="view-section">
    <article>
        <h3>✅ マイ習慣一覧（ワンタップ実行）</h3>
        <div id="habits-list">読み込み中...</div>
    </article>
</section>

<!-- ボトムナビゲーションバー（画面下部固定） -->
<nav class="bottom-nav">
    <a href="#" id="nav-timeline" class="bottom-nav-item active" onclick="switchView('timeline', event)">
        <span class="nav-icon">👥</span>
        <span class="nav-label">タイムライン</span>
    </a>
    <a href="#" id="nav-task-check" class="bottom-nav-item" onclick="switchView('task-check', event)">
        <span class="nav-icon">✅</span>
        <span class="nav-label">タスクのチェック</span>
    </a>
    <a href="/Settings" id="nav-settings" class="bottom-nav-item">
        <span class="nav-icon">⚙️</span>
        <span class="nav-label">設定</span>
    </a>
</nav>

<script>
    let currentUserId = 1;
    let currentUserEmoji = '👤';
    let currentUserName = '@Model.CurrentUser';

    /**
     * ボトムナビゲーション選択時に表示するセクションを切り替えます。
     * @@param {string} viewName 表示対象の画面名 ('timeline', 'task-check')
     * @@param {Event} event イベントオブジェクト
     */
    function switchView(viewName, event) {
        if (event) event.preventDefault();

        // すべてのセクションを非表示
        const sections = document.querySelectorAll('.view-section');
        sections.forEach(s => s.classList.remove('active'));

        // ボトムナビリンクの active クラス解除
        const navLinks = document.querySelectorAll('.bottom-nav-item');
        navLinks.forEach(l => l.classList.remove('active'));

        // 対象セクションおよびナビリンクをアクティブ化
        const targetSection = document.getElementById(`section-${viewName}`);
        const targetLink = document.getElementById(`nav-${viewName}`);
        const pageTitle = document.getElementById('page-title');

        if (targetSection) targetSection.classList.add('active');
        if (targetLink) targetLink.classList.add('active');

        // タイトルおよびデータ取得処理の切り替え
        switch (viewName) {
            case 'timeline':
                pageTitle.innerText = '習慣トラッカー - タイムライン';
                loadTimeline();
                break;
            case 'task-check':
                pageTitle.innerText = '習慣トラッカー - タスクのチェック';
                loadHabits();
                break;
        }
    }

    async function loadUser() {
        const res = await fetch(`/api/users/me`);
        if (res.ok) {
            const u = await res.json();
            currentUserId = u.id;
            currentUserEmoji = u.emoji || '👤';
            currentUserName = u.name || '@Model.CurrentUser';
        }
    }

    async function loadHabits() {
        const res = await fetch(`/api/habits?userId=${currentUserId}`);
        const habits = await res.json();
        const container = document.getElementById('habits-list');

        if (!habits || habits.length === 0) {
            container.innerHTML = '<p>登録されている習慣がありません。</p>';
            return;
        }

        container.innerHTML = habits.map(h => `
            <div class="habit-item" style="flex-wrap: wrap; gap: 10px;">
                <div style="flex: 1; min-width: 200px;">
                    <span style="font-size: 1.3em;">${escapeHtml(h.emoji || '📝')}</span>
                    <strong>${escapeHtml(h.title)}</strong> (${escapeHtml(h.frequency)})
                    ${h.description ? `<p style="margin: 4px 0 0; font-size: 0.9em; opacity: 0.8;">${escapeHtml(h.description)}</p>` : ''}
                </div>
                <div style="display: flex; gap: 8px; align-items: center; flex: 1; min-width: 280px; justify-content: flex-end;">
                    <input type="text" id="habit-comment-${h.id}" placeholder="記録コメント（任意）" style="margin-bottom: 0; padding: 6px 10px; font-size: 0.9em; flex: 1;">
                    <button style="margin-bottom: 0; width: auto;" onclick="executeHabit(${h.id})">✅ 実行</button>
                </div>
            </div>
        `).join('');
    }

    async function executeHabit(habitId) {
        const commentInput = document.getElementById(`habit-comment-${habitId}`);
        const commentText = commentInput ? commentInput.value.trim() : '';

        const res = await fetch(`/api/habits/${habitId}/execute`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: currentUserId, comment: commentText || 'ワンタップ実行！' })
        });

        if (res.ok) {
            if (commentInput) commentInput.value = '';
            loadTimeline();
            alert('🎉 習慣の実行を記録しました！');
        } else {
            alert('実行記録の保存に失敗しました。');
        }
    }

    let userGroups = [];

    async function loadGroups() {
        const res = await fetch(`/api/groups?userId=${currentUserId}`);
        if (!res.ok) return;
        userGroups = await res.json();

        const filterSelect = document.getElementById('group-filter');
        if (!filterSelect) return;

        const currentFilter = filterSelect.value;
        filterSelect.innerHTML = '<option value="all">すべての投稿</option>';

        userGroups.forEach(g => {
            const option = document.createElement('option');
            option.value = g.id;
            option.textContent = `🏢 ${g.name}`;
            filterSelect.appendChild(option);
        });

        if (userGroups.some(g => g.id.toString() === currentFilter)) {
            filterSelect.value = currentFilter;
        }
    }

    async function loadTimeline() {
        const selectedGroupId = document.getElementById('group-filter')?.value || 'all';
        const endpoint = selectedGroupId === 'all'
            ? `/api/timeline?limit=15`
            : `/api/groups/${selectedGroupId}/timeline?limit=15`;

        const res = await fetch(endpoint);
        const items = await res.json();
        const container = document.getElementById('timeline-list');

        if (!items || items.length === 0) {
            container.innerHTML = '<p>まだタイムラインに記録がありません。</p>';
            return;
        }

        const quickEmojis = ['👍', '🔥', '🎉', '❤️', '👏'];

        container.innerHTML = items.map(item => `
            <div class="timeline-item">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <div style="display: flex; align-items: center; gap: 8px; font-weight: bold;">
                        <span style="font-size: 1.4em;">${escapeHtml(item.userEmoji || '👤')}</span>
                        <span>${escapeHtml(item.userName)}</span>
                    </div>
                    <small style="opacity: 0.7;">${new Date(item.executedAt).toLocaleString('ja-JP')}</small>
                </div>
                <div style="display: flex; align-items: center; gap: 6px; font-size: 1.1em; font-weight: bold; margin-bottom: 6px;">
                    <span style="font-size: 1.3em;">${escapeHtml(item.habitEmoji || '📝')}</span>
                    <span>${escapeHtml(item.habitTitle)}</span>
                </div>
                ${item.comment ? `<p style="margin: 4px 0 8px; opacity: 0.9;">コメント: ${escapeHtml(item.comment)}</p>` : ''}

                <div class="reaction-bar">
                    ${(item.reactions || []).map(r => `
                        <span class="reaction-badge" title="タップしてリアクションを切り替え" onclick="toggleReaction(${item.logId}, '${escapeHtml(r.emoji)}')">${escapeHtml(r.emoji)} ${r.count}</span>
                    `).join('')}
                    <span style="opacity: 0.4;">|</span>
                    ${quickEmojis.map(emoji => `
                        <button class="secondary outline" style="padding: 2px 8px; margin-bottom: 0; width: auto; font-size: 0.9em;" onclick="toggleReaction(${item.logId}, '${emoji}')">${emoji}</button>
                    `).join('')}
                </div>

                <!-- コメントセクション -->
                <div style="margin-top: 12px; border-top: 1px dashed var(--pico-muted-border-color, #2d3843); padding-top: 10px; font-size: 0.9em;">
                    <div id="comments-list-${item.logId}">
                        ${(item.comments || []).map(c => `
                            <div class="comment-item">
                                <div>
                                    <span>${escapeHtml(c.userEmoji)} <strong>${escapeHtml(c.userName)}</strong>: ${escapeHtml(c.commentText)}</span>
                                </div>
                                <div style="display: flex; align-items: center; gap: 6px;">
                                    <small style="opacity: 0.6;">${new Date(c.createdAt).toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit' })}</small>
                                    ${c.userId === currentUserId ? `<button style="background: none; border: none; color: #ef4444; cursor: pointer; font-size: 0.8em; padding: 0; margin-bottom: 0; width: auto;" onclick="deleteComment(${c.id})">❌</button>` : ''}
                                </div>
                            </div>
                        `).join('')}
                    </div>
                    <form style="display: flex; gap: 6px; margin-top: 8px; margin-bottom: 0;" onsubmit="postComment(event, ${item.logId})">
                        <input type="text" id="comment-input-${item.logId}" placeholder="応援コメントを入力..." required style="margin-bottom: 0; padding: 6px 10px; font-size: 0.9em; flex: 1;">
                        <button type="submit" style="padding: 6px 12px; font-size: 0.85em; width: auto; margin-bottom: 0;">送信</button>
                    </form>
                </div>
            </div>
        `).join('');
    }

    async function toggleReaction(logId, emoji) {
        const res = await fetch(`/api/logs/${logId}/reactions`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: currentUserId, reactionType: emoji })
        });

        if (res.ok) {
            loadTimeline();
        } else {
            alert('リアクションの送信に失敗しました。');
        }
    }

    async function postComment(e, logId) {
        e.preventDefault();
        const inputEl = document.getElementById(`comment-input-${logId}`);
        const text = inputEl ? inputEl.value : '';

        if (!text.trim()) return;

        const res = await fetch(`/api/logs/${logId}/comments`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: currentUserId, commentText: text })
        });

        if (res.ok) {
            loadTimeline();
        } else {
            alert('コメントの送信に失敗しました。');
        }
    }

    async function deleteComment(commentId) {
        if (!confirm('このコメントを削除しますか？')) return;

        const res = await fetch(`/api/comments/${commentId}`, {
            method: 'DELETE'
        });

        if (res.ok) {
            loadTimeline();
        } else {
            alert('コメントの削除に失敗しました。');
        }
    }

    function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // 初期ロード（デフォルトでタイムラインを表示）
    async function init() {
        await loadUser();
        loadGroups();
        loadTimeline();
    }

    init();
</script>
