@*
    モジュール名: Pages/Shared/_Layout.cshtml
    説明: Razor Pages アプリケーション全体の共通レイアウトです。Pico.css (dark mode) および htmx を読み込みます。
*@
<!DOCTYPE html>
<html lang="ja" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - HabitTracker</title>
    <!-- Pico.css classless CDN (Dark mode enabled via data-theme="dark") -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@picocss/pico@2/css/pico.classless.min.css">
    <!-- htmx JavaScript ライブラリ -->
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
</head>
<body>
    <main>
        @RenderBody()
    </main>
</body>
</html>
