@*
    モジュール名: Views/Login.cshtml
    説明: HabitTracker のログイン画面ビューテンプレート（Pico.css対応）です。
*@
@model LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "ログイン";
}

<div style="max-width: 400px; margin: 50px auto 0 auto;">
    <article>
        <h2 style="text-align: center;">🔑 ログイン</h2>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <p style="color: var(--pico-del-color, #ef4444); margin-bottom: 15px;"><small>@Model.ErrorMessage</small></p>
        }
        <form action="/login" method="post">
            <label for="username">ユーザー名
                <input type="text" id="username" name="Username" required autofocus placeholder="admin">
            </label>
            <label for="password">パスワード
                <input type="password" id="password" name="Password" required placeholder="secret-password">
            </label>
            <button type="submit">ログイン</button>
        </form>
    </article>
</div>
